{
    "name": "silunilabs/behat-cucumber-formatter",
    "description": "Behat 4 extension writing a Cucumber JSON report (with tags)",
    "type": "behat-extension",
    "license": "MIT",
    "keywords": ["behat", "cucumber", "json", "formatter"],
    "require": {
        "php": ">=8.4",
        "behat/behat": "^4.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "SiluniLabs\\BehatCucumberFormatter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SiluniLabs\\BehatCucumberFormatter\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text",
        "phpstan": "phpstan",
        "cs": "php-cs-fixer fix --dry-run --diff"
    }
}
